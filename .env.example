# ==============================================================
# TakaCode - Variables d'environnement
# ==============================================================
# Copie ce fichier en .env.local et remplis les valeurs.
# 
# Utilise Supabase pour auth, BDD, et RLS.
# L'IA Review utilise un systeme de fallback multi-provider.
# ==============================================================

# --- Supabase (requis) ---
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon
# Alternative recommandee par les nouveaux projets Supabase. L'application
# accepte ANON_KEY ou PUBLISHABLE_KEY ; une seule des deux est necessaire.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# --- Admin emails (requis) ---
# Emails des admins bootstrap (separes par des virgules)
TAKACODE_ADMIN_EMAILS=admin@example.com
# Fallback client temporaire utilise uniquement avant le bootstrap des roles DB.
NEXT_PUBLIC_TAKACODE_ADMIN_EMAILS=

# --- Site URL (optionnel) ---
NEXT_PUBLIC_SITE_URL=https://takacode.app
# Alias historique encore accepte par certains composants.
NEXT_PUBLIC_APP_URL=https://takacode.app

# --- Scripts ---
# Mot de passe du compte admin pour le script bootstrap-admin.mjs
SUPABASE_TAKACODE_PASSWORD=votre_mot_de_passe

# --- IA Review (optionnel sauf si AI_REVIEW_PROVIDER != huggingface) ---
AI_REVIEW_PROVIDER=mistral
AI_REVIEW_FALLBACK=openrouter,gemini,huggingface
AI_REVIEW_API_KEY=
AI_REVIEW_OPEN_ROUTER_API_KEY=
AI_REVIEW_OPENROUTER_API_KEY=
AI_REVIEW_GEMINI_API_KEY=
AI_REVIEW_HUGGINGFACE_API_KEY=
# Providers utilises par le chat et les assistants contextuels.
AI_MISTRAL_API_KEY=
AI_REVIEW_MISTRAL_API_KEY=
MISTRAL_API_KEY=
AI_OPENAI_API_KEY=
OPENAI_API_KEY=
AI_REVIEW_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
AI_REVIEW_ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_REVIEW_MODEL=meta-llama/llama-3.2-3b-instruct
AI_REVIEW_OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct,qwen/qwen-2.5-7b-instruct
AI_REVIEW_GEMINI_MODEL=gemini-2.0-flash
AI_REVIEW_HUGGINGFACE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
GROQ_API_KEY=
SUPABASE_DB_PASSWORD=

# Google Search Console verification (meta-tag method).
# 1) Add https://takacode.app in Search Console.
# 2) Pick "HTML tag" verification, copy the content="XYZ" value.
# 3) Set here + in Vercel env vars, redeploy.
GOOGLE_SITE_VERIFICATION=

# Same for Bing Webmaster Tools (optional).
BING_SITE_VERIFICATION=
